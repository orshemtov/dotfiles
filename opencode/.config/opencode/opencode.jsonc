{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [],
  "lsp": {
    "pyright": {
      "disabled": true,
    },
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"],
    },
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["xcodebuildmcp", "mcp"],
      "enabled": true,
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
    },
  },
}
