{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [],
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["xcodebuildmcp", "mcp"],
      "enabled": true
    },
    "apple-reminders": {
      "type": "local",
      "command": ["apple-reminders-mcp"],
      "enabled": true
    },
    "apple-calendar": {
      "type": "local",
      "command": ["apple-calendar-mcp"],
      "enabled": true
    }
  }
}
