{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [],
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "command": [
        "/Users/or/Projects/dotfiles/opencode/.config/opencode/github-mcp.sh"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
